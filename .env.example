# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
POSTGRES_PORT=5432

# --- Backend ---
# Async URL for SQLAlchemy (asyncpg). Inside Docker the host is "db".
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
LOG_LEVEL=INFO
API_PORT=8000
# Database the integration tests recreate on every run.
TEST_DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_test

# --- External provider (mock) ---
# The app only knows the public URL and the token; never the mock's DB or controls.
PROVIDER_BASE_URL=http://localhost:4010/v1
PROVIDER_TOKEN=travel-demo-token
PROVIDER_TIMEOUT_SECONDS=5

# --- Bookings and worker (ADR 0003) ---
# Seconds of 404 by reference before resending the same POST with the same key.
BOOKING_UNKNOWN_GRACE_SECONDS=30
# A 'submitted' older than this lost its sender; must exceed PROVIDER_TIMEOUT_SECONDS.
BOOKING_SUBMITTED_STALE_SECONDS=60
BOOKING_PENDING_POLL_SECONDS=5
BOOKING_RETRY_BASE_SECONDS=2
BOOKING_RETRY_MAX_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_JOB_LEASE_SECONDS=120
WORKER_BATCH_SIZE=10

# --- Documents and status channel (ADR 0005) ---
DOCUMENT_STORAGE_DIR=data/documents
DOCUMENT_MAX_ATTEMPTS=3
DOCUMENT_SWEEP_INTERVAL_SECONDS=300
EVENTS_POLL_SECONDS=1
EVENTS_HEARTBEAT_SECONDS=15

# --- Frontend (nginx serves the UI and proxies /api to the API) ---
FRONTEND_PORT=5173

# --- Provider mock (only the provider-mock service reads these) ---
MOCK_PORT=4010
MOCK_QUOTE_TTL_SECONDS=900
MOCK_SUPPLIER_DEADLINE_SECONDS=2

# --- MCP (ADR 0006) ---
# Signs the MCP session tokens (user identity). Change it in any real deployment.
MCP_TOKEN_SECRET=dev-only-insecure-mcp-secret
MCP_TOKEN_TTL_SECONDS=300
# Hosts accepted by /mcp (the SDK's DNS rebinding protection).
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1:*","api:*"]

# --- Assistant: Google Gemini with the official google-genai SDK (ADR 0006) ---
# Without a key, the chat responds 503 and the model evaluations are skipped.
GEMINI_API_KEY=
# Current stable Flash according to Google's documentation (verified on 2026-11-17).
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high (gemini-3.8-flash does not support minimal).
GEMINI_THINKING_LEVEL=low
ASSISTANT_MAX_ITERATIONS=6
ASSISTANT_TIMEOUT_SECONDS=60

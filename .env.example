# Copiar a .env y ajustar. Nunca versionar .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
POSTGRES_PORT=5432

# --- Backend ---
# URL async para SQLAlchemy (asyncpg). Dentro de Docker el host es "db".
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel
LOG_LEVEL=INFO
API_PORT=8000
# Base de datos que los tests de integración recrean en cada ejecución.
TEST_DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_test

# --- Proveedor externo (mock) ---
# La app solo conoce la URL pública y el token; nunca la BD ni los controles del mock.
PROVIDER_BASE_URL=http://localhost:4010/v1
PROVIDER_TOKEN=travel-demo-token
PROVIDER_TIMEOUT_SECONDS=5

# --- Reservas y worker (ADR 0003) ---
# Segundos con 404 por referencia antes de reenviar el mismo POST con la misma clave.
BOOKING_UNKNOWN_GRACE_SECONDS=30
# Un 'submitted' más antiguo que esto perdió a su emisor; debe superar PROVIDER_TIMEOUT_SECONDS.
BOOKING_SUBMITTED_STALE_SECONDS=60
BOOKING_PENDING_POLL_SECONDS=5
BOOKING_RETRY_BASE_SECONDS=2
BOOKING_RETRY_MAX_SECONDS=60
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_JOB_LEASE_SECONDS=120
WORKER_BATCH_SIZE=10

# --- Documentos y canal de estado (ADR 0005) ---
DOCUMENT_STORAGE_DIR=data/documents
DOCUMENT_MAX_ATTEMPTS=3
DOCUMENT_SWEEP_INTERVAL_SECONDS=300
EVENTS_POLL_SECONDS=1
EVENTS_HEARTBEAT_SECONDS=15

# --- Mock del proveedor (solo el servicio provider-mock lo lee) ---
MOCK_PORT=4010
MOCK_QUOTE_TTL_SECONDS=900
MOCK_SUPPLIER_DEADLINE_SECONDS=2

# --- MCP (ADR 0006) ---
# Firma los tokens de sesión MCP (identidad del usuario). Cambiar en cualquier despliegue real.
MCP_TOKEN_SECRET=dev-only-insecure-mcp-secret
MCP_TOKEN_TTL_SECONDS=300
# Hosts aceptados por /mcp (protección contra DNS rebinding del SDK).
MCP_ALLOWED_HOSTS=["localhost","localhost:*","127.0.0.1:*","api:*"]

# --- Asistente: Google Gemini con el SDK oficial google-genai (ADR 0006) ---
# Sin clave, el chat responde 503 y las evaluaciones con modelo se saltan.
GEMINI_API_KEY=
# Flash estable vigente según la documentación de Google (verificado el 2026-11-17).
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high (gemini-3.8-flash no admite minimal).
GEMINI_THINKING_LEVEL=low
ASSISTANT_MAX_ITERATIONS=6
ASSISTANT_TIMEOUT_SECONDS=60
